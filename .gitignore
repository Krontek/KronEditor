# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


Releases/

# Large per-arch build artifacts (lib/*.a, server binaries, headers pulled from
# the separate Krontek libraries repo) stay out of git.
/resources/*
# EXCEPTION: the HAL headers are source-of-truth for this repo and ARE tracked —
# they are maintained here, not pulled from the separate repo.
!/resources/krontek-include/
/resources/krontek-include/*
!/resources/krontek-include/HAL/

# Backend Artifacts
bin/
build/plc.h
build/plc.c
build/simulation
.codex

# Packaging build artifacts (multi-GB: binaries, toolchains, AppImage)
packaging/dist/
# Generated by build-windows.sh from package.json (installer version define)
packaging/windows/version.iss
# Persistent windows-host LLVM (downloaded once by build-windows.sh)
toolchains-win/
toolchains/*
experiments/*
