# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


Releases/

# Large per-arch build artifacts (lib/*.a, server binaries, headers pulled from
# the separate Krontek libraries repo) stay out of git.
/resources/*
# EXCEPTION: the HAL headers are source-of-truth for this repo and ARE tracked —
# they are maintained here, not pulled from the separate repo.
!/resources/krontek-include/
/resources/krontek-include/*
!/resources/krontek-include/HAL/
# EXCEPTION: kronsystem.h is written and maintained HERE (header-only blocks that
# need no libkron*.a rebuild) — not pulled from the Krontek libraries repo, so a
# fresh clone must get it or every project using its blocks fails to compile.
!/resources/krontek-include/kronsystem.h

# Backend Artifacts
bin/
build/plc.h
build/plc.c
build/simulation
.codex

# Packaging build artifacts. packaging/ holds ONLY the two build scripts in git;
# each script emits ONE multi-hundred-MB artifact next to itself and stages
# everything else in packaging/tmplinux/ or packaging/tmpwin/ (deleted on exit).
packaging/tmplinux/
packaging/tmpwin/
packaging/tmpmac/
packaging/*.AppImage
packaging/*.exe
packaging/*.dmg
# Persistent windows-host LLVM (downloaded once by build-windows.sh)
toolchains-win/
toolchains/*
experiments/*

# Compiled host-agent binaries. Reproducible from source (npm run build, or a
# bare `go build` in host-agent/); a committed ~14 MB blob cannot be reviewed in
# a PR and bloats history on every rebuild.
/dist-binary/
/host-agent/kron-host-agent
/host-agent/kron-host-agent.exe
