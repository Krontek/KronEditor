                    <mxGeometry x="60" y="360" width="400" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="hs_s1" value="1 · write logic_&lt;alt&gt;.so.tmp → rename over alt slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="60" y="400" width="360" height="40" as="geometry"/>
