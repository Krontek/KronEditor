                <mxCell id="hs_title" value="Hot-swap — state-preserving live code update (Linux) · same plc.c, -DPLC_HOTSWAP" style="text;html=1;fontSize=16;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="hs_host" value="Loader-host (STABLE process)  host.c · compiled -rdynamic&#10;• owns PlcState in HOST memory → survives swap&#10;• /dev/shm mirror · timing · scan threads&#10;• host_glue.c __hs_* trampolines keep HAL fds host-side" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;" parent="1" vertex="1">
