                    <mxGeometry x="640" y="190" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="hs_slotnote" value="2-slot ping-pong · swap targets the slot NOT running&#10;PingPongGeneration(confirmedGen) — gen never grows&#10;atomic tmp+rename → fresh inode · CleanupExcept after OK" style="text;html=1;fontSize=11;align=left;fontColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="640" y="260" width="360" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="hs_abi" value="Fixed .so ABI (swappable POU logic)&#10;plc_state_size · plc_bind · plc_state_init&#10;plc_task_body_&lt;i&gt; · plc_shm_name · plc_state_layout_hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="120" width="380" height="90" as="geometry"/>
                </mxCell>
