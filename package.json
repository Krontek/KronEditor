{
  "name": "KronEditor",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names \"vite,agent\" --prefix-colors \"cyan,magenta\" \"npm:dev:frontend\" \"npm:dev:host-agent\"",
    "dev:frontend": "vite",
    "dev:host-agent": "cd host-agent && go run .",
    "build:frontend": "vite build",
    "build:host-agent": "cd host-agent && go build -ldflags \"-X main.appVersion=$npm_package_version\" -o ../dist-binary/kron-host-agent .",
    "build": "npm run build:frontend && npm run build:host-agent",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.4",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
